---
const contacts = [
	{
		name: 'Dra. Carla Ornela Roncati',
		number: '+54 9 11 5598-8495',
		url: 'https://wa.me/5491155988495?text=Hola%20Dra.%20Carla%20Ornela%20Roncati,%20quisiera%20realizar%20una%20consulta',
	},
	{
		name: 'Dra. Gloria Isabel Biodre',
		number: '+54 9 223 312-2883',
		url: 'https://wa.me/5492233122883?text=Hola%20Gloria%20Isabel%20Biodre,%20quisiera%20realizar%20una%20consulta',
	},
];
---

<div class="whatsapp-widget" data-whatsapp-widget>
	<div class="whatsapp-menu" id="whatsapp-contacts" role="menu" aria-label="Elegir contacto de WhatsApp" aria-hidden="true" data-whatsapp-menu>
		<div class="whatsapp-menu-heading">
			<strong>¿Con quién querés hablar?</strong>
			<span>Elegí un contacto para continuar.</span>
		</div>
		{contacts.map((contact) => (
			<a class="whatsapp-contact" href={contact.url} target="_blank" rel="noopener" role="menuitem">
				<span class="whatsapp-contact-icon" aria-hidden="true">WA</span>
				<span>
					<strong>{contact.name}</strong>
					<small>{contact.number}</small>
				</span>
				<span class="whatsapp-contact-arrow" aria-hidden="true">→</span>
			</a>
		))}
	</div>

	<button class="whatsapp-toggle" type="button" aria-label="Elegir contacto de WhatsApp" aria-haspopup="menu" aria-controls="whatsapp-contacts" aria-expanded="false" data-whatsapp-toggle>
		<svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16.03 3C8.85 3 3 8.7 3 15.72c0 2.47.72 4.88 2.08 6.94L3 29l6.58-2.04a13.2 13.2 0 0 0 6.44 1.66h.01C23.21 28.62 29 22.92 29 15.9 29 8.72 23.2 3 16.03 3Zm7.7 18.13c-.33.93-1.95 1.79-2.7 1.9-.69.1-1.56.14-2.52-.16-.58-.18-1.32-.43-2.28-.84-4.01-1.7-6.62-5.66-6.82-5.92-.2-.26-1.63-2.16-1.63-4.12 0-1.95 1.03-2.91 1.39-3.31.36-.4.79-.5 1.06-.5.26 0 .53 0 .76.01.24.01.57-.09.9.68.33.78 1.12 2.7 1.22 2.9.1.2.16.43.03.69-.13.26-.2.43-.4.66-.2.23-.42.51-.6.68-.2.2-.41.42-.18.82.23.4 1.02 1.68 2.19 2.72 1.5 1.34 2.77 1.76 3.17 1.96.4.2.63.17.86-.1.23-.26.99-1.15 1.25-1.55.26-.4.53-.33.89-.2.36.13 2.28 1.08 2.67 1.27.4.2.66.3.76.46.1.17.1.96-.23 1.89Z"/></svg>
		<span>WhatsApp</span>
	</button>
</div>

<script>
	const widget = document.querySelector<HTMLElement>('[data-whatsapp-widget]');
	const toggle = widget?.querySelector<HTMLButtonElement>('[data-whatsapp-toggle]');
	const menu = widget?.querySelector<HTMLElement>('[data-whatsapp-menu]');

	const setOpen = (open: boolean) => {
		widget?.classList.toggle('is-open', open);
		toggle?.setAttribute('aria-expanded', String(open));
		menu?.setAttribute('aria-hidden', String(!open));
		if (open) menu?.querySelector<HTMLAnchorElement>('a')?.focus();
	};

	toggle?.addEventListener('click', () => setOpen(!widget?.classList.contains('is-open')));
	menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
	document.addEventListener('click', (event) => {
		if (widget && !widget.contains(event.target as Node)) setOpen(false);
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			setOpen(false);
			toggle?.focus();
		}
	});
</script>
