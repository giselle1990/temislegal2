---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import WhatsAppMenu from '../components/WhatsAppMenu.astro';
import Layout from '../layouts/Layout.astro';
import { legalAreas } from '../data/areas';
import { withBase } from '../utils/paths';

const services = [
	{ icon: '▣', title: 'Consultas jurídicas online', text: 'Orientación profesional para evaluar tu situación y definir los próximos pasos.' },
	{ icon: '✎', title: 'Escritos y contratos', text: 'Redacción, revisión y adecuación de documentos legales con lenguaje claro y preciso.' },
	{ icon: '◆', title: 'Mediaciones y negociaciones', text: 'Intervención estratégica para facilitar acuerdos y proteger tus intereses.' },
	{ icon: '⌂', title: 'Patrocinio y representación', text: 'Acompañamiento profesional en instancias administrativas y judiciales.' },
];

---

<Layout title="Temis Legal | Consultora Jurídica" description="Asesoramiento, gestión y representación legal en todo el país.">
	<Header />
	<main>
		<HeroCarousel />

		<section class="section about" id="nosotros">
			<div class="section-heading reveal">
				<span class="eyebrow">Sobre Temis Legal</span>
				<h2>Una mirada profesional, cercana y estratégica.</h2>
			</div>
			<div class="about-grid">
				<div class="about-copy reveal">
					<p>En Temis Legal brindamos asesoramiento y representación jurídica integral, con el objetivo de ofrecer soluciones claras, eficientes y adaptadas a cada situación particular.</p>
					<p>Nuestro estudio está conformado por profesionales del derecho con experiencia en diversas ramas. Trabajamos bajo los principios de confidencialidad, ética profesional y compromiso con la defensa de los intereses de nuestros clientes.</p>
				</div>
				<div class="stats reveal">
					<article><strong>100%</strong><span>Atención personalizada</span></article>
					<article><strong>24/7</strong><span>Canal de contacto online</span></article>
					<article><strong>Todo el país</strong><span>Asesoramiento a distancia</span></article>
				</div>
			</div>
		</section>

		<section class="section soft-section" id="servicios">
			<div class="section-heading centered reveal">
				<span class="eyebrow">Servicios</span>
				<h2>Asistencia jurídica integral</h2>
				<p>Te acompañamos desde la primera consulta hasta la resolución de tu caso.</p>
			</div>
			<div class="services-grid">
				{services.map((service) => (
					<article class="service-card reveal">
						<span class="service-icon">{service.icon}</span>
						<h3>{service.title}</h3>
						<p>{service.text}</p>
					</article>
				))}
			</div>
		</section>

		<section class="section" id="areas">
			<div class="section-heading centered reveal">
				<span class="eyebrow">Áreas de práctica</span>
				<h2>Soluciones jurídicas para cada necesidad</h2>
			</div>
			<div class="areas-grid">
				{legalAreas.map((area) => (
					<article class:list={['area-card', 'reveal', { featured: area.featured }]} tabindex="0">
						<div class="area-card-inner">
							<div class="area-face area-front">
								<span>{area.icon}</span>
								<h3>{area.title}</h3>
								<small>Pasá el cursor para conocer más</small>
							</div>
							<div class="area-face area-back">
								<h3>{area.title}</h3>
								<p>{area.shortDescription}</p>
								<a href={withBase(`areas/${area.slug}`)}>Ver más</a>
							</div>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="section contact" id="contacto">
			<div class="contact-card reveal">
				<span class="eyebrow">Hablemos</span>
				<h2>¿Listo para analizar tu caso?</h2>
				<p>Contactanos para coordinar una consulta confidencial.</p>
				<ul>
					<li><strong>WhatsApp Temis Legal:</strong> +54 9 11 5598-8495</li>
					<li><strong>Gloria Isabel Biodre:</strong> +54 9 223 312-2883</li>
					<li><strong>Email:</strong> temislegal85@gmail.com</li>
					<li><strong>Web:</strong> www.temisestudio.com.ar</li>
					<li><strong>Instagram:</strong> @temis.legal</li>
				</ul>
				<a class="button contact-button" href="https://wa.me/5491155988495?text=Hola%20Temis%20Legal,%20quisiera%20realizar%20una%20consulta" target="_blank" rel="noopener">Consultar por WhatsApp</a>
			</div>
		</section>
	</main>

	<WhatsAppMenu />
	<Footer />
</Layout>

<script>
	const revealItems = document.querySelectorAll<HTMLElement>('.reveal');
	const observer = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				entry.target.classList.add('is-visible');
				observer.unobserve(entry.target);
			}
		});
	}, { threshold: 0.12 });
	revealItems.forEach((item) => observer.observe(item));

	document.querySelectorAll<HTMLElement>('.area-card').forEach((card) => {
		card.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) return;
			card.classList.toggle('is-flipped');
		});
	});
</script>
